[node name="Txt" type="Label" parent="AboutModal/Margin/VBox/Scroll/GuideVBox/BossCard/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.88, 0.95, 1)
theme_override_font_sizes/font_size = 13
text = "При запуске зарядки Телепорта пробуждается древний страж.
Укрывайтесь за монолитами и колоннами от непрерывного лазерного луча из ока титана.
Подпрыгивайте перед топотом титана, чтобы избежать радиальной ударной волны."

