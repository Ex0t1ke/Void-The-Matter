[node name="GuideLabel" type="Label" parent="AboutModal/Margin/VBox/Scroll" unique_id=361864419]
layout_mode = 2
size_flags_horizontal = 3
text = "• УПРАВЛЕНИЕ ДЕСАНТНИКОМ:
   WASD — перемещение
   Мышь — круговой обзор и наведение 360°
   ЛКМ — парные бластеры (Double Tap)
   ПКМ — фазовый бронебойный лазер (Phase Round)
   Shift / C — тактический кувырок (кадры неуязвимости)
   Пробел — прыжок / двойной прыжок с Пером Хопу
   E — взаимодействие с Сундуками и Телепортом

• АРТЕФАКТЫ И СИНЕРГИЯ ПРЕДМЕТОВ:
   - Солдатский Шприц (Syringe): +15% к скорострельности бластеров.
   - Бензин (Gasoline): поджигает врагов и взрывает область при убийстве.
   - Укулеле (Ukulele): выпускает цепную молнию по 3 ближайшим целям.
   - Перо Хопу (Hopoo Feather): дарует дополнительный прыжок в воздухе.
   - Плюшевый Мишка (Tough Times): 15% шанс полностью заблокировать любой урон.

• БОСС ЛОКАЦИИ: КАМЕННЫЙ ТИТАН:
   - Активируйте Телепорт в глубине острова, чтобы начать зарядку.
   - Из земли восстанет древний Каменный Титан с лазерным оком.
   - Прячьтесь за многогранными скалами и руинами древних колонн от лазера.
   - Подпрыгивайте перед топотом титана, чтобы избежать ударной волны!"
autowrap_mode = 2

