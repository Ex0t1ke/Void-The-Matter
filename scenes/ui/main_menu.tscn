[node name="Txt" type="Label" parent="AboutModal/Margin/VBox/Scroll/GuideVBox/ControlsCard/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.88, 0.95, 1)
theme_override_font_sizes/font_size = 13
text = "WASD — Свободное перемещение в 3D
Мышь — Полный круговой обзор и прицеливание 360°
ЛКМ — Парные бластеры десантника (Double Tap)
ПКМ — Фазовый бронебойный лазер (Phase Round)
Shift / C — Тактический кувырок (кадры неуязвимости)
Пробел — Прыжок / Мульти-прыжок (с Пером Хопу)
E — Активация сундуков, прыжковых панелей и Телепорта"

